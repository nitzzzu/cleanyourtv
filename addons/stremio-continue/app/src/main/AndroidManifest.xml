<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Stremio's "Continue Watching" preview channel in the TV provider (docs/watch-next.md).
         Granted by install.sh with pm grant. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Poster images: Stremio's rows point at https:// artwork. Nothing else goes over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.stremio.one" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="stremio" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".ContinueActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Clean Your TV module card (docs/specs/card.md). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- The launcher's content_rows reads this; RowsProvider refuses every other caller. -->
        <provider
            android:name=".RowsProvider"
            android:authorities="io.github.nitzzzu.stremiocontinue.rows"
            android:exported="true" />
    </application>
</manifest>
